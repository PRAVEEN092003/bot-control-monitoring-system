# ─────────────────────────────────────────────
# Bot Control and Monitoring System — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────

# Flask core
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=sqlite:///bot_monitor.db

# Admin bootstrap credentials (used only during first-run init)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@2024!

# Rate limiting backend (memory for development; use redis:// in production)
RATELIMIT_STORAGE_URI=memory://

# Session security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CAPTCHA settings
CAPTCHA_LENGTH=6
CAPTCHA_EXPIRY_SECONDS=120

# Risk score thresholds
RISK_SUSPICIOUS_THRESHOLD=31
RISK_HIGH_THRESHOLD=61

# Temporary IP block duration (in minutes)
IP_BLOCK_DURATION_MINUTES=30
